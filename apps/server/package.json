{
  "name": "@dnd/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-database.ts",
    "test:auth": "tsx --env-file-if-exists=.env scripts/check-auth.ts",
    "test:campaigns": "tsx --env-file-if-exists=.env scripts/check-campaigns.ts",
    "test:rooms": "tsx --env-file-if-exists=.env scripts/check-rooms.ts",
    "test:production": "tsx --env-file-if-exists=.env scripts/check-production.ts",
    "test:live": "tsx --env-file-if-exists=.env scripts/check-live.ts"
  },
  "dependencies": {
    "@dnd/shared": "^0.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0"
  }
}
