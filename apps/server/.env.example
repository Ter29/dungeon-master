PORT=3001
APP_ORIGIN=http://localhost:5173
# On Render production: omit APP_ORIGIN to use RENDER_EXTERNAL_URL automatically.
# NODE_ENV=production enables Secure cookies; serve frontend and /api on one origin.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Server-only Cloudinary credential. Do not expose via VITE_* or commit the real value.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Use a direct (non-pooler) Neon connection for migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional audio limits; defaults below. Server-only, no paid service required.
# AUDIO_MAX_BYTES=20971520
# AUDIO_MAX_SECONDS=1800
# AUDIO_SFX_MAX_SECONDS=30
# AUDIO_MAX_ASSETS=100
# AUDIO_CAMPAIGN_BYTES=262144000
