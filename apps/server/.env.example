PORT=3001
APP_ORIGIN=http://localhost:5173
# On Render production: omit APP_ORIGIN to use RENDER_EXTERNAL_URL automatically.
# NODE_ENV=production enables Secure cookies; serve frontend and /api on one origin.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional direct connection for migrations (defaults to DATABASE_URL).
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
