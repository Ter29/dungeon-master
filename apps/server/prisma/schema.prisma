generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  DM
  PLAYER
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(254)
  displayName  String           @db.VarChar(80)
  passwordHash String
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  memberships  CampaignMember[]
  invites      Invite[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(120)
  version          Int              @default(0)
  roomState        Json             @default("{\"activeScene\":\"scene-1\",\"positions\":{\"scene-1\":{\"x\":50,\"y\":50},\"scene-2\":{\"x\":50,\"y\":50}}}")
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  members          CampaignMember[]
  invites          Invite[]
  locations        Scene[]          @relation("CampaignScenes")
  mediaFiles       MediaFile[]
  activeLocationId String?          @db.Uuid
  activeLocation   Scene?           @relation("ActiveLocation", fields: [activeLocationId], references: [id], onDelete: SetNull)
  locationVersion  Int              @default(0)
}

model CampaignMember {
  campaignId String       @db.Uuid
  userId     String       @db.Uuid
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now()) @db.Timestamptz(3)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique @db.VarChar(64)
  campaignId  String    @db.Uuid
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdById])
  @@index([expiresAt])
}

model Scene {
  id           String     @id @default(uuid()) @db.Uuid
  campaignId   String     @db.Uuid
  name         String     @db.VarChar(120)
  description  String     @default("") @db.VarChar(4000)
  backgroundId String?    @unique @db.Uuid
  revision     Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  campaign     Campaign   @relation("CampaignScenes", fields: [campaignId], references: [id], onDelete: Cascade)
  background   MediaFile? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  activeIn     Campaign[] @relation("ActiveLocation")

  @@index([campaignId])
}

model MediaFile {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @db.Uuid
  storageKey String    @unique
  format     String    @db.VarChar(4)
  mimeType   String    @db.VarChar(20)
  byteSize   Int
  width      Int
  height     Int
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene      Scene?

  @@index([campaignId])
  @@index([deletedAt])
}
