generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  DM
  PLAYER
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(254)
  displayName  String           @db.VarChar(80)
  passwordHash String
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  memberships  CampaignMember[]
  invites      Invite[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  audioVersion           Int                    @default(0)
  audioAssets            AudioAsset[]
  audioChannels          AudioChannel[]
  audioCues              AudioCue[]
  presentationMode       DisplayMode            @default(TABLE)
  presentationMaterialId String?                @db.Uuid
  presentationVersion    Int                    @default(0)
  presentationMaterial   PresentationMaterial?  @relation("ActivePresentation", fields: [presentationMaterialId], references: [id], onDelete: SetNull)
  presentationMaterials  PresentationMaterial[] @relation("CampaignPresentations")
  encounters             CombatEncounter[]
  combatVersion          Int                    @default(0)
  sharedMaps             SharedMap[]
  mapFragments           MapFragment[]
  id                     String                 @id @default(uuid()) @db.Uuid
  name                   String                 @db.VarChar(120)
  version                Int                    @default(0)
  roomState              Json                   @default("{\"activeScene\":\"scene-1\",\"positions\":{\"scene-1\":{\"x\":50,\"y\":50},\"scene-2\":{\"x\":50,\"y\":50}}}")
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)
  members                CampaignMember[]
  invites                Invite[]
  locations              Scene[]                @relation("CampaignScenes")
  mediaFiles             MediaFile[]
  activeLocationId       String?                @db.Uuid
  activeLocation         Scene?                 @relation("ActiveLocation", fields: [activeLocationId], references: [id], onDelete: SetNull)
  locationVersion        Int                    @default(0)
}

enum AudioCategory {
  MUSIC
  AMBIENCE
  SFX
}

enum AudioStatus {
  PLAYING
  PAUSED
  STOPPED
}

model AudioAsset {
  id          String @id @default(uuid()) @db.Uuid
  campaignId  String @db.Uuid
  name        String @db.VarChar(120)
  description String @default("") @db.VarChar(2000)
  category    AudioCategory
  storageKey  String @unique
  format      String @db.VarChar(4)
  mimeType    String @db.VarChar(32)
  byteSize    Int
  duration    Float
  revision    Int @default(0)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channels    AudioChannel[] @relation("AudioCurrent")
  outgoing    AudioChannel[] @relation("AudioOutgoing")
  cues        AudioCue[]
  @@index([campaignId])
  @@index([deletedAt])
}

model AudioChannel {
  campaignId String @db.Uuid
  key        String @db.VarChar(24)
  assetId    String? @db.Uuid
  status     AudioStatus @default(STOPPED)
  position   Float @default(0)
  startedAt  DateTime? @db.Timestamptz(3)
  loop       Boolean @default(true)
  volume     Float @default(1)
  fadeFrom   Float @default(1)
  fadeTo     Float @default(1)
  fadeAt     DateTime? @db.Timestamptz(3)
  fadeMs     Int @default(0)
  outgoingAssetId String? @db.Uuid
  outgoingPosition Float @default(0)
  outgoingStartedAt DateTime? @db.Timestamptz(3)
  outgoingLoop Boolean @default(false)
  outgoingGain Float @default(1)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset AudioAsset? @relation("AudioCurrent", fields: [assetId], references: [id], onDelete: SetNull)
  outgoingAsset AudioAsset? @relation("AudioOutgoing", fields: [outgoingAssetId], references: [id], onDelete: SetNull)
  @@id([campaignId, key])
}

model AudioCue {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  assetId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset AudioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([campaignId, createdAt])
  @@index([expiresAt])
}

model CampaignMember {
  campaignId String       @db.Uuid
  userId     String       @db.Uuid
  role       CampaignRole @default(PLAYER)
  joinedAt   DateTime     @default(now()) @db.Timestamptz(3)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  codeHash    String    @unique @db.VarChar(64)
  campaignId  String    @db.Uuid
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdById])
  @@index([expiresAt])
}

model Scene {
  encounters    CombatEncounter[]
  fogMask       String            @default("") @db.VarChar(4096)
  fogRevision   Int               @default(0)
  gridVisible   Boolean           @default(false)
  gridSize      Float             @default(50)
  gridOffsetX   Float             @default(0)
  gridOffsetY   Float             @default(0)
  tableRevision Int               @default(0)
  tokens        Token[]
  id            String            @id @default(uuid()) @db.Uuid
  campaignId    String            @db.Uuid
  name          String            @db.VarChar(120)
  description   String            @default("") @db.VarChar(4000)
  backgroundId  String?           @unique @db.Uuid
  revision      Int               @default(0)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  campaign      Campaign          @relation("CampaignScenes", fields: [campaignId], references: [id], onDelete: Cascade)
  background    MediaFile?        @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  activeIn      Campaign[]        @relation("ActiveLocation")

  @@index([campaignId])
}

model MediaFile {
  presentationImage PresentationMaterial?
  mapBackground     SharedMap?
  fragment          MapFragment?
  token             Token?
  id                String                @id @default(uuid()) @db.Uuid
  campaignId        String                @db.Uuid
  storageKey        String                @unique
  format            String                @db.VarChar(4)
  mimeType          String                @db.VarChar(20)
  byteSize          Int
  width             Int
  height            Int
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  deletedAt         DateTime?             @db.Timestamptz(3)
  campaign          Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene             Scene?

  @@index([campaignId])
  @@index([deletedAt])
}

enum TokenKind {
  PLAYER
  NPC
  ENEMY
}

model Token {
  combatParticipants CombatParticipant[]
  id                 String              @id @default(uuid()) @db.Uuid
  sceneId            String              @db.Uuid
  name               String              @db.VarChar(80)
  kind               TokenKind           @default(NPC)
  x                  Float               @default(50)
  y                  Float               @default(50)
  size               Float               @default(50)
  hidden             Boolean             @default(true)
  revision           Int                 @default(0)
  imageId            String?             @unique @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  scene              Scene               @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  image              MediaFile?          @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([sceneId, hidden])
}

model SharedMap {
  id           String       @id @default(uuid()) @db.Uuid
  campaignId   String       @db.Uuid
  name         String       @db.VarChar(120)
  description  String       @default("") @db.VarChar(4000)
  width        Int          @default(2000)
  height       Int          @default(1200)
  available    Boolean      @default(false)
  revision     Int          @default(0)
  dataVersion  Int          @default(0)
  backgroundId String?      @unique @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  background   MediaFile?   @relation(fields: [backgroundId], references: [id], onDelete: SetNull)
  elements     MapElement[]

  @@index([campaignId])
}

model MapFragment {
  id         String       @id @default(uuid()) @db.Uuid
  campaignId String       @db.Uuid
  name       String       @db.VarChar(120)
  issued     Boolean      @default(false)
  revision   Int          @default(0)
  imageId    String?      @unique @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  image      MediaFile?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  elements   MapElement[]

  @@index([campaignId])
}

enum MapElementKind {
  NOTE
  MARKER
  LINE
  ROUTE
  CONTOUR
  FRAGMENT
}

model MapElement {
  id         String         @id @default(uuid()) @db.Uuid
  mapId      String         @db.Uuid
  kind       MapElementKind
  text       String         @default("") @db.VarChar(1000)
  color      String         @default("#242424") @db.VarChar(7)
  x          Float          @default(0)
  y          Float          @default(0)
  points     Json           @default("[]")
  scale      Float          @default(1)
  rotation   Float          @default(0)
  locked     Boolean        @default(false)
  revision   Int            @default(0)
  fragmentId String?        @db.Uuid
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  map        SharedMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fragment   MapFragment?   @relation(fields: [fragmentId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([fragmentId])
}

enum CombatStatus {
  PREPARING
  ACTIVE
  ENDED
}

model CombatEncounter {
  id                   String              @id @default(uuid()) @db.Uuid
  campaignId           String              @db.Uuid
  sceneId              String              @db.Uuid
  status               CombatStatus        @default(PREPARING)
  round                Int                 @default(1)
  version              Int                 @default(0)
  manualOrder          Boolean             @default(false)
  nextSequence         Int                 @default(0)
  currentParticipantId String?             @unique @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  startedAt            DateTime?           @db.Timestamptz(3)
  endedAt              DateTime?           @db.Timestamptz(3)
  campaign             Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene                Scene               @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  participants         CombatParticipant[] @relation("Roster")
  currentParticipant   CombatParticipant?  @relation("CurrentTurn", fields: [currentParticipantId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([sceneId])
}

model CombatParticipant {
  id          String           @id @default(uuid()) @db.Uuid
  encounterId String           @db.Uuid
  tokenId     String           @db.Uuid
  initiative  Int              @default(0)
  joinOrder   Int
  position    Int
  encounter   CombatEncounter  @relation("Roster", fields: [encounterId], references: [id], onDelete: Cascade)
  token       Token            @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  currentIn   CombatEncounter? @relation("CurrentTurn")

  @@unique([encounterId, tokenId])
  @@unique([encounterId, joinOrder])
  @@index([encounterId, position])
  @@index([tokenId])
}

enum DisplayMode {
  TABLE
  ILLUSTRATION
  PORTRAIT
  BLANK
}

enum PresentationCategory {
  LOCATION
  NPC
  EVENT
}

model PresentationMaterial {
  id          String               @id @default(uuid()) @db.Uuid
  campaignId  String               @db.Uuid
  name        String               @db.VarChar(120)
  description String               @default("") @db.VarChar(4000)
  category    PresentationCategory
  imageId     String?              @unique @db.Uuid
  revision    Int                  @default(0)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  campaign    Campaign             @relation("CampaignPresentations", fields: [campaignId], references: [id], onDelete: Cascade)
  image       MediaFile?           @relation(fields: [imageId], references: [id], onDelete: SetNull)
  activeIn    Campaign[]           @relation("ActivePresentation")

  @@index([campaignId])
}
